# LiveKit configuration
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend configuration
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# TTS mode: auto, gpu, cpu
# auto = detect NVIDIA GPU, fallback to CPU if not available
TTS_MODE=auto

# Auralis TTS (GPU mode)
AURALIS_HOST=auralis
AURALIS_PORT=9950

# Kokoro TTS (CPU mode)
KOKORO_HOST=kokoro
KOKORO_PORT=8880

# Parakeet STT
PARAKEET_HOST=parakeet
PARAKEET_PORT=5092

# LLM for translation
LLAMA_HF_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
LLAMA_MODEL_ALIAS=qwen3-4b
LLAMA_MODEL=qwen3-4b
LLAMA_BASE_URL=http://llama_cpp:11434/v1
LLAMA_CTX_SIZE=8192
LLAMA_HOST_PORT=11436

# OpenAI API key (not required for local inference)
OPENAI_API_KEY=no-key-needed
