# Environment variables for local development
# Copy to .env.local and modify as needed

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# TTS mode: gpu or cpu
TTS_MODE=cpu

# Service URLs (for local development, use localhost ports)
PARAKEET_BASE_URL=http://localhost:5092/v1
KOKORO_BASE_URL=http://localhost:8880/v1
AURALIS_BASE_URL=http://localhost:9950/v1
LLAMA_BASE_URL=http://localhost:11436/v1
LLAMA_MODEL=qwen3-4b

OPENAI_API_KEY=no-key-needed
